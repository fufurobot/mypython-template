# Set to "uv", "pdm", or "micromamba". If unset, projects with a root
# notebooks/ directory use micromamba and other projects use uv. A Binder
# workspace always uses micromamba, with the environment that Binder provides.
DEPENDENCY_MANAGER=uv

# Personal access token used by the dependency watcher to manage the remote CI
# configuration. Copy this file to .env and replace the placeholder; .env is
# ignored by git.
GITHUB_TOKEN=github_pat_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
