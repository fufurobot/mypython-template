{
  "name": "stupidinfer",
  "image": "ghcr.io/bartventer/devcontainer-images/base-archlinux",
  "postCreateCommand": "bash .devcontainer/post-install.sh",
  "postStartCommand": "bash .devcontainer/watch-requirements.sh",
  "remoteEnv": {
    "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  "remoteUser": "vscode"
}
